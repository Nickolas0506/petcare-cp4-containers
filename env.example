# =============================================================================
# PetCare - modelo das variaveis de ambiente
#
# Copie este arquivo para .env e preencha com os seus valores.
# O .env esta no .gitignore e NUNCA deve ir para o repositorio.
#
# No PowerShell, antes de rodar os scripts:
#     $env:RM = "rm564099"
#     $env:DB_PASSWORD = "SuaSenhaForte123!"
# =============================================================================

# RM usado como prefixo de todos os recursos e imagens
RM=rm564099

# Regiao da Azure (Azure for Students nao libera todas)
LOCATION=mexicocentral

# Senha do usuario da aplicacao no MySQL
DB_PASSWORD=troque-esta-senha

# Senha do root do MySQL (se ficar vazia, reaproveita a DB_PASSWORD)
DB_ROOT_PASSWORD=
